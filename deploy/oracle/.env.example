# Use a real domain like api.example.com, or for a quick free demo use:
# BACKEND_DOMAIN=129.154.12.34.sslip.io
BACKEND_DOMAIN=replace-with-your-domain-or-ip.sslip.io

# Your Vercel frontend URL.
FRONTEND_URL=https://natwest-zeta.vercel.app
CORS_ORIGINS=["https://natwest-zeta.vercel.app"]

# Generate a new secret with: openssl rand -hex 32
SECRET_KEY=replace-with-a-new-secret

# Rotate the leaked key before using production.
ANTHROPIC_API_KEY=replace-with-rotated-anthropic-key

ENVIRONMENT=prod
CLAUDE_MODEL=claude-sonnet-4-6
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INSIGHTX_DATA_DIR=/opt/insightx/data
